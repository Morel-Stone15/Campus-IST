# ── Flask ─────────────────────────────────────────────────────────────────────
FLASK_ENV=development
FLASK_DEBUG=1

# ── Security (minimum 32 chars in production) ─────────────────────────────────
SECRET_KEY=change-this-to-a-secure-random-key
JWT_SECRET_KEY=change-this-jwt-secret-key

# ── Database ──────────────────────────────────────────────────────────────────
# Development uses SQLite.  On Render, set this to your PostgreSQL URL.
# If PostgreSQL is unreachable, the app will automatically fall back to SQLite.
DATABASE_URL=sqlite:///campus.db
# DB_PROBE_TIMEOUT=5       # seconds to wait per PostgreSQL probe
# DB_PROBE_RETRIES=2       # number of probe attempts before SQLite fallback

# ── Uploads ───────────────────────────────────────────────────────────────────
MAX_CONTENT_LENGTH=16777216
UPLOAD_FOLDER=app/uploads
ALLOWED_EXTENSIONS=pdf,png,jpg,jpeg,gif,mp3,wav

# ── JWT ───────────────────────────────────────────────────────────────────────
JWT_ACCESS_TOKEN_EXPIRES=3600
JWT_REFRESH_TOKEN_EXPIRES=2592000

# ── Firebase (optional) ───────────────────────────────────────────────────────
FIREBASE_CREDENTIALS=

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO              # DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_TO_FILE=0               # Set to 1 to write rotating log files in production
# LOG_DIR=campus-plus/logs  # Override log directory (absolute or relative)

# ── Gunicorn (Render) ─────────────────────────────────────────────────────────
# GUNICORN_WORKERS=2
# GUNICORN_TIMEOUT=120
